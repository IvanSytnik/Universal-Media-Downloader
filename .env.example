# Copy to .env and fill in:  cp .env.example .env
#
# Two profiles. Pick one and leave the other's lines as they are.
#
#   minimal  Bot API at api.telegram.org, no extra credentials. Uploads are
#            capped at 50 MB by Telegram: MP3s and short clips arrive; most
#            YouTube videos do not (720p is typically 300+ MB) and get a
#            "too large" message after the download.
#
#   full     Local Telegram Bot API server (the telegram-bot-api service),
#            uploads up to 2000 MB, so 720p/1080p videos arrive. Needs an
#            application id/hash and a one-time logOut of the bot from the
#            cloud Bot API before the first start (README, Quick start).
#
# Every variable below has a default in src/config/settings.py except
# BOT_TOKEN. Lists and objects are JSON.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Telegram (both profiles) ---
# From @BotFather.
BOT_TOKEN=123456:REPLACE_WITH_REAL_TOKEN

# --- Local Bot API server (profile: full) ---
# minimal: keep USE_LOCAL_BOT_API=false and the two credentials empty.
# full: USE_LOCAL_BOT_API=true plus both credentials, a free application
# registration at https://my.telegram.org/apps (not the bot token). The
# bot refuses to start with the flag on and either one missing.
USE_LOCAL_BOT_API=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LOCAL_BOT_API_BASE_URL=http://telegram-bot-api:8081

# Largest file the bot tries to send, in MB.
# minimal: 50 (Telegram's cloud limit).  full: up to 2000.
MAX_DELIVERABLE_FILE_SIZE_MB=50

# --- PostgreSQL ---
# Change the password for anything but a local machine.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=umd
POSTGRES_USER=umd
POSTGRES_PASSWORD=umd

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Host ports for psql / redis-cli from the host machine (bound to
# 127.0.0.1). Not the same as POSTGRES_PORT/REDIS_PORT above, which are
# used inside the Docker network. Change them if 5433/6380 are taken.
HOST_POSTGRES_PORT=5433
HOST_REDIS_PORT=6380

# --- Access control ---
# Telegram user ids allowed to run /health, /worker_ping, /worker_status.
# Empty list = nobody (fail closed). Find your id via @userinfobot.
ADMIN_TELEGRAM_IDS=[]

# --- Sources (SECURITY.md) ---
# Allowlist, suffix match per label ("youtube.com" covers www. and m.).
# An empty list allows every site yt-dlp supports: development only.
ALLOWED_DOMAINS=["youtube.com","youtu.be","tiktok.com","instagram.com","twitter.com","x.com","vk.com"]
# Exceptions to the allowlist, checked first. YouTube Music is extracted as
# plain YouTube, so only its URL can exclude it.
BLOCKED_DOMAINS=["music.youtube.com"]
# Format kill-switch: lowercased yt-dlp extractor key -> formats to hide on
# the preview card and refuse. Example: {"youtube": ["audio"]}
DISABLED_FORMATS={}

# --- Localization ---
# Fallback when the user has no /language choice and Telegram's
# language_code is not a supported locale (en, ru).
DEFAULT_LOCALE=en

# --- Rate limits (per Telegram user, sliding window) ---
RATE_LIMIT_DOWNLOADS_PER_HOUR=10
RATE_LIMIT_PREVIEWS_PER_MINUTE=5

# --- Timeouts, seconds ---
# How long a preview card's buttons stay usable.
PREVIEW_CONTEXT_TTL_SECONDS=600
# One preview extraction; on expiry the extraction process is killed.
PREVIEW_TIMEOUT_SECONDS=60
# One download. Keep it below the worker's job_timeout (2100 s), or arq
# cancels the job before the downloader can stop and report the timeout.
DOWNLOAD_TIMEOUT_SECONDS=1800
# Uploading one file to Telegram (a 2 GB upload to the local server can
# take several minutes).
FILE_UPLOAD_TIMEOUT_SECONDS=1800
# Stale-request reaper: a pending/processing request untouched for the
# worker's job_timeout (2100 s) plus this is failed and its user told.
STALE_REQUEST_GRACE_SECONDS=300

# --- Worker ---
# Concurrent downloads per worker. Each one is a yt-dlp process plus
# ffmpeg (a few hundred MB of RAM, up to ~2x the file on disk) and one
# more request from this host's IP to the source site, which is what
# sites rate-limit and block. Size it to the host; raise
# DOWNLOAD_MIN_FREE_DISK_MB with it.
WORKER_MAX_JOBS=4

# --- Disk guard ---
# Downloads are refused when less than this many MB are free in the
# download volume. Rule of thumb: 2 x the largest file x concurrent
# downloads. 0 disables the check.
DOWNLOAD_MIN_FREE_DISK_MB=3072

# --- Observability ---
# LOG_DIR is set by docker-compose.yml (/var/log/umd, volume app_logs);
# set it here only for runs outside Docker.
# LOG_DIR=./logs
# Rotation: size per file, files kept.
LOG_FILE_MAX_MB=50
LOG_FILE_BACKUPS=10
# Error reporting; empty keeps Sentry off.
SENTRY_DSN=
